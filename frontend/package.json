{
  "name": "repovantage-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RepoVantage frontend — Vue 3 + TypeScript + Vite + Tailwind 4 + AntV G2 5",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:author-concentration": "node scripts/test-author-concentration.mjs",
    "test:chart-analytics": "node scripts/test-chart-analytics.mjs",
    "test:commit-activity": "node scripts/test-commit-activity.mjs",
    "test:duration-histogram": "node scripts/test-duration-histogram.mjs",
    "test:issue-trend": "node scripts/test-issue-trend.mjs",
    "test:e2e:issue-trend": "node scripts/e2e-issue-trend.mjs",
    "test:e2e:commit-activity": "node scripts/e2e-commit-activity.mjs",
    "test:paged-records": "node scripts/test-paged-records.mjs",
    "capture": "node scripts/capture.mjs",
    "test:e2e:analysis-window": "node scripts/e2e-analysis-window.mjs",
    "test:e2e:selection-weights": "node scripts/e2e-selection-weights.mjs",
    "test:e2e:research-dashboard": "node scripts/e2e-research-dashboard.mjs",
    "test:e2e:research-v44": "node scripts/e2e-research-v44.mjs",
    "test:e2e:collection-empty-state": "node scripts/e2e-collection-empty-state.mjs"
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "dompurify": "^3.4.17",
    "lucide-vue-next": "^0.468.0",
    "marked": "^18.1.1",
    "pinia": "^2.2.6",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "puppeteer-core": "^25.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}
