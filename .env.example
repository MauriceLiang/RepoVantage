API_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_KEY=replace-with-a-long-random-local-secret
# Optional personal access token; can also be managed in the Settings page.
GITHUB_TOKEN=
DATABASE_URL=sqlite:///./data/app.db
RAW_DATA_DIR=./data/raw
WORKER_POLL_SECONDS=3
BASE_REFRESH_HOURS=24
WORKER_HEARTBEAT_SECONDS=10
WORKER_LEASE_SECONDS=120
GITHUB_TIMEOUT_SECONDS=15
# 0 = fetch every page in the selected time window; 1-10000 sets a per-endpoint cap.
GITHUB_MAX_PAGES=0
